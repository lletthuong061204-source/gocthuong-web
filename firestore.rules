rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admins: accounts with the custom claim role == "admin" (set by scripts/sync.ts in CI).
    // Readers: anyone signed in. They can only touch their own saved items and send resources for review.
    // The public site never reads content from the browser: it is exported at build time.
    function isAdmin() {
      return request.auth != null && request.auth.token.role == "admin";
    }
    function isUser(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function str(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Each reader's saved posts and resources.
    match /users/{uid}/saved/{itemId} {
      allow read, delete: if isUser(uid);
      allow create, update: if isUser(uid)
        && request.resource.data.keys().hasOnly(["type", "ref", "title", "url", "savedAt"])
        && request.resource.data.type in ["post", "resource"]
        && str(request.resource.data.ref, 1, 300)
        && str(request.resource.data.title, 0, 300)
        && str(request.resource.data.url, 1, 500)
        && request.resource.data.savedAt is int;
    }

    // Each reader's private notes on posts (select text → "Ghi chú"). Only the owner can see them.
    match /users/{uid}/notes/{noteId} {
      allow read, delete: if isUser(uid);
      allow create: if isUser(uid) && validNote(request.resource.data);
      allow update: if isUser(uid) && validNote(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["text", "updatedAt"]);
    }
    function validNote(d) {
      return d.keys().hasOnly(["post", "lang", "quote", "prefix", "suffix", "start", "text", "createdAt", "updatedAt"])
        && str(d.post, 1, 200)
        && d.lang in ["vi", "en", "zh"]
        && str(d.quote, 1, 1000)
        && str(d.prefix, 0, 64)
        && str(d.suffix, 0, 64)
        && d.start is int && d.start >= 0
        && str(d.text, 0, 2000)
        && d.createdAt is int
        && d.updatedAt is int;
    }

    // Readers can send a resource for review and see the ones they sent. Only admins approve.
    match /resources/{id} {
      allow read: if request.auth != null && resource.data.submittedBy == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(["title", "url", "desc", "cat", "by", "likes", "status", "submittedBy", "createdAt"])
        && request.resource.data.status == "pending"
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.likes == 0
        && str(request.resource.data.title, 1, 200)
        && str(request.resource.data.url, 8, 500)
        && request.resource.data.url.matches("^https?://.+")
        && str(request.resource.data.desc, 0, 500)
        && str(request.resource.data.by, 1, 60)
        && request.resource.data.cat in ["BA", "AI", "NGÔN NGỮ", "THIẾT KẾ", "KỸ THUẬT"]
        && request.resource.data.createdAt is int;
    }
  }
}
